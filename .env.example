# Vercel → Project → Settings → Environment Variables bölümüne eklenecek değişkenler.

# Cloudinary (görsel yükleme)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upstash Redis (blog, portfolyo, hero ve istatistik verileri)
# Upstash konsolu → veritabanı → "REST API" bölümü.
# Vercel Marketplace'ten Upstash eklerseniz KV_REST_API_URL ve KV_REST_API_TOKEN
# otomatik oluşur; o durumda bu ikisine gerek yoktur.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
